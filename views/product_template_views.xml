<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="product_template_form_compat" model="ir.ui.view">
    <field name="name">product.template.form.compat</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='categ_id']" position="after">
        <field name="catalog_section" />
        <field name="machine_ids" widget="many2many_tags"
          invisible="catalog_section == 'machine'" />
        <field name="part_ids" widget="many2many_tags"
          invisible="catalog_section != 'machine'" />
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Refacciones y servicios" name="compat_parts"
          invisible="catalog_section != 'machine'">
          <field name="part_ids" nolabel="1"
            context="{'default_catalog_section': 'spare'}">
            <list>
              <field name="name" string="Refacción / Servicio" />
              <field name="catalog_section" string="Tipo" />
              <field name="default_code" string="Referencia interna" />
              <field name="list_price" string="Precio" />
            </list>
            <form>
              <group>
                <field name="name" />
                <field name="catalog_section" />
                <field name="default_code" />
                <field name="list_price" />
              </group>
            </form>
          </field>
        </page>
      </xpath>
    </field>
  </record>
</odoo>